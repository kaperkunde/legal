{
  "name": "@kaperkunde/legal-docs",
  "version": "0.0.0",
  "description": "Kaperkunde's legal documents as published markdown, with a manifest of the commit, date and release tag each one stands at.",
  "license": "UNLICENSED",
  "homepage": "https://github.com/kaperkunde/legal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaperkunde/legal.git"
  },
  "files": [
    "manifest.json",
    "*.md",
    "*/*.md",
    "!CHANGELOG.md",
    "!*/CHANGELOG.md"
  ],
  "exports": {
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "scripts": {
    "manifest": "node scripts/manifest.mjs",
    "prepack": "node scripts/manifest.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
